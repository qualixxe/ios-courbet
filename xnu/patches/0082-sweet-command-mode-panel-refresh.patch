--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -1215,3 +1215,28 @@
+/*
+ * Command-mode panel refresh kick for courbet (SM7150 SDE).
+ * After the CPU copies a new frame to the panel memory (fPixels), the
+ * display controller (SDE at 0xae00000) must be told to start a new frame
+ * transfer on the primary DSI interface (CTL_1, offset 0x2200).
+ * The FLUSH register is at CTL_1 base + 0x4.
+ * MDSS base = 0xae00000, CTL_1 off = 0x2200, FLUSH = 0x4.
+ */
+static void
+sweet_panel_refresh(void)
+{
+#if defined(SWEET)
+	const uint32_t sde_base = 0xae00000;
+	const uint32_t ctl1_off = 0x2200;
+	const uint32_t flush_off = 0x4;
+	volatile uint32_t *flush_reg = (volatile uint32_t *)(sde_base + ctl1_off + flush_off);
+
+	/* The register is write-only; writing any value triggers a frame transfer. */
+	*flush_reg = 1;
+
+	IOLog("SWEET FB: panel refresh kick @ %p\n", flush_reg);
+#endif
+}
+
+
 void
 AppleCLCD::swap(const uint8_t *rec)
 {
@@ -1289,6 +1322,8 @@
 		s->release();
 	}
+	/* command-mode panel needs a kick after the CPU flush to panel memory */
+	sweet_panel_refresh();
 }
 
