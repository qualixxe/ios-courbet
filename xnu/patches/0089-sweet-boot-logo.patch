+static inline void
+sweet_draw_boot_logo(uintptr_t pixels, uint32_t width, uint32_t height, uint32_t rowBytes)
+{
+	uint32_t x, y;
+
+	if (width < SWEET_LOGO_CANVAS || height < SWEET_LOGO_CANVAS) {
+		return;
+	}
+
+	/* The boot screen is black; erase whatever the console drew before us. */
+	for (y = 0; y < height; y++) {
+		uint32_t *row = (uint32_t *)(pixels + (uint64_t)y * rowBytes);
+		for (x = 0; x < width; x++) {
+			row[x] = 0xff000000;
+		}
+	}
+
+	int ox = ((int)width - SWEET_LOGO_CANVAS) / 2 + 128;
+	int oy = ((int)height - SWEET_LOGO_CANVAS) / 2 + 50;
+	for (y = 0; y < SWEET_LOGO_H; y++) {
+		uint32_t *row = (uint32_t *)(pixels + (uint64_t)(oy + y) * rowBytes) + ox;
+		for (x = 0; x < SWEET_LOGO_W; x++) {
+			uint8_t b = sweet_logo_mask[(y * SWEET_LOGO_W + x) >> 2];
+			uint8_t q = (b >> (6 - 2 * (x & 3))) & 3;
+			if (q != 0) {
+				uint32_t v = (uint32_t)q * 85;
+				row[x] = 0xff000000 | (v << 16) | (v << 8) | v;
+			}
+		}
+	}
+}
